# Copy to .env and fill in.

# Which vendor backs the pipeline: "openai" or "gemini".
# Gemini has a free tier (Google AI Studio key) — grounding with Google Search
# and native PDF vision are both included, which is everything SKUForge needs.
SKUFORGE_PROVIDER=gemini

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Paid: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Set to 1 to run the whole pipeline against fixtures, with no API calls
SKUFORGE_MOCK=0
