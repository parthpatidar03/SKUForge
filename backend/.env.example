# Copy to .env and fill in.

# Which profile backs the pipeline: "openai", "gemini", "openrouter", or
# "hybrid" (recommended — entirely free, and easiest on Gemini's daily quota).
#
#   hybrid     - Gemini free tier for web search + PDF vision only (2-3
#                calls/SKU); everything else runs on free OpenRouter models.
#                Needs GEMINI_API_KEY and OPENROUTER_API_KEY.
#   gemini     - everything on Gemini's free tier (~8 calls/SKU — burns the
#                20/day quota roughly 3x faster than hybrid).
#   openrouter - free models only; NO web search or PDF vision, so scouting
#                and datasheet parsing won't work. Rarely what you want alone.
#   openai     - paid, highest quality, ~$0.02-0.03/SKU.
SKUFORGE_PROVIDER=hybrid

# Free: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Paid: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Set to 1 to run the whole pipeline against fixtures, with no API calls
SKUFORGE_MOCK=0
